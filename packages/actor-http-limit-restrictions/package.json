{
  "name": "@comunica/actor-http-limit-restrictions",
  "version": "5.4.0",
  "description": "Comunica HTTP bus actor that respects the advertised restrictions of endpoints",
  "lsd:module": true,
  "license": "MIT",
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/comunica-association"
  },
  "homepage": "https://comunica.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/comunica/comunica.git",
    "directory": "packages/actor-http-limit-restrictions"
  },
  "bugs": {
    "url": "https://github.com/comunica/comunica/issues"
  },
  "keywords": [
    "comunica",
    "actor",
    "http",
    "limit-restrictions"
  ],
  "sideEffects": false,
  "main": "lib/index.js",
  "typings": "lib/index",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "components",
    "lib/**/*.d.ts",
    "lib/**/*.js",
    "lib/**/*.js.map"
  ],
  "scripts": {
    "build": "yarn run build:ts && yarn run build:components",
    "build:ts": "node \"../../node_modules/typescript/bin/tsc\"",
    "build:components": "componentsjs-generator"
  },
  "dependencies": {
    "@comunica/bus-http": "^5.4.0",
    "@comunica/bus-http-invalidate": "^5.4.0",
    "@comunica/context-entries": "^5.4.0",
    "@comunica/core": "^5.4.0",
    "@comunica/mediatortype-time": "^5.4.0",
    "@comunica/types": "^5.4.0"
  }
}
